<script>
const sections=[
 {name:'Грамматика',icon:'Aa',desc:'Собирай предложения и выбирай время по смыслу.',lessons:['present','past','future']},
 {name:'Разговорная практика',icon:'◌',desc:'Проигрывай короткие ситуации и отвечай вслух.',lessons:['coffee','garden']},
 {name:'Новые слова',icon:'✦',desc:'Используй пять знакомых слов в своих фразах.',lessons:['words','story']},
 {name:'Неправильные глаголы',icon:'⇄',desc:'Вспоминай V1–V2–V3 небольшими группами.',lessons:['verbs','verbs2']}
];
const lessons={
 present:{title:'Present Simple или Continuous?',min:12,rule:'Present Simple — привычка или факт. Present Continuous (am/is/are + V-ing) — действие сейчас или временная ситуация.',note:'I study English every day. I’m studying English right now.',task:'Вспомни одно привычное действие и одно действие прямо сейчас. Скажи обе фразы вслух.',q:[
 ['Собери фразу: usually / I / English / study / in the evening.','I usually study English in the evening.'],
 ['Переведи: «Я сейчас записываю новые слова».','I’m writing down new words right now.'],
 ['Переведи: «Она работает дома, но сегодня работает в кафе».','She works from home, but today she’s working in a café.']]},
 past:{title:'Past Perfect и Past Perfect Continuous',min:16,rule:'Past Perfect (had + V3) подчёркивает завершённое действие к моменту в прошлом. Past Perfect Continuous (had been + V-ing) подчёркивает процесс или длительность до того момента.',note:'By the time I arrived, she had left. She had been waiting for an hour before I arrived.',task:'Расскажи о вчерашнем вечере. Сначала назови событие, затем то, что произошло до него или длилось какое-то время.',q:[
 ['Переведи: «Когда я пришла, урок уже начался».','When I arrived, the lesson had already started.'],
 ['Переведи: «Я занималась уже час, когда она позвонила».','I had been studying for an hour when she called.'],
 ['Собери фразу: by the time / we / arrived / the rain / had / stopped.','By the time we arrived, the rain had stopped.']]},
 future:{title:'Три способа говорить о будущем',min:14,rule:'Will часто используют для решения в момент речи. Be going to — для намерения. Present Continuous может обозначать договорённость.',note:'I’ll help you. I’m going to study tonight. I’m meeting Anna at six.',task:'Скажи вслух, что ты планируешь сделать завтра и о чём уже договорилась.',q:[
 ['Тебя просят помочь, и ты соглашаешься. Скажи: «Я тебе помогу».','I’ll help you.'],
 ['Переведи: «Я собираюсь повторить английский вечером».','I’m going to review my English this evening.'],
 ['Есть договорённость. Переведи: «Я встречаюсь с Анной в шесть».','I’m meeting Anna at six.']]},
 coffee:{title:'Заказ в кафе',min:10,rule:'Прочитай реплику бариста и ответь вслух. После самопроверки повтори весь диалог без подсказок, изменив напиток и размер.',note:'Could I have …? / Is it for here or to go? / To go, please.',task:'Проиграй сцену дважды: сначала за себя, потом за бариста. На второй попытке добавь вопрос о цене.',q:[
 ['Barista: Hi! What can I get you? Закажи маленький капучино.','Could I have a small cappuccino, please?'],
 ['Barista: For here or to go? Попроси с собой.','To go, please.'],
 ['Barista: Anything else? Скажи, что больше ничего, и спроси, сколько с тебя.','That’s all, thanks. How much is it?']]},
 garden:{title:'Расскажи про сад мечты',min:15,rule:'Представь, что знакомая просит описать твой идеальный сад. На каждый вопрос ответь вслух двумя короткими предложениями.',note:'I’d like … / There would be … / I’d put … next to … because …',task:'Повтори ответы одним монологом на 45–60 секунд. Добавь, что бы ты изменила в саду зимой.',q:[
 ['What kind of garden would you like to design?','I’d like to design a small garden with lots of flowers. It would feel quiet and private.'],
 ['What would you put next to the path?','I’d put lavender next to the path because I love the smell.'],
 ['Where would you sit and relax?','I’d put a bench under a tree. It would be a good place to read.']]},
 words:{title:'Пять слов в своих предложениях',min:12,rule:'Возьми пять сегодняшних слов из Duolingo. Для каждого придумай фразу о себе. Если слово не подходит, придумай реальную ситуацию, где ты могла бы его услышать.',note:'Слово → моя фраза → вопрос с этим словом. Например: choose → I usually choose tea. → What do you usually choose?',task:'Закрой список, вспомни пять слов по своим фразам и произнеси два вопроса вслух.',q:[
 ['Запиши свои пять слов.','Сверь написание и значение каждого слова с Duolingo.',true],
 ['Напиши по одному предложению для каждого слова.','Проверь подлежащее, глагол и порядок слов. Пример с choose: I usually choose tea.',true],
 ['Преврати две фразы в вопросы.','Проверь вспомогательный глагол и порядок слов. Пример: Do you usually choose tea?',true]]},
 story:{title:'Мини-история из знакомых слов',min:15,rule:'Выбери пять слов из недавних занятий. Возьми хотя бы три для истории о событии, остальные два используй в вопросах к ней.',note:'Yesterday … / Then … / In the end …',task:'Расскажи историю вслух за минуту. Затем ответь на свои вопросы полными предложениями.',q:[
 ['Впиши пять слов.','Сверь написание, затем вспомни значения без подсказки.',true],
 ['Напиши 3–5 предложений о вчерашнем событии.','Проверь, что события идут в понятном порядке, а завершённые события выражены в Past Simple. Образец: Yesterday I found a small café. Then I ordered tea.',true],
 ['Придумай два вопроса к истории.','Проверь форму глагола после did. Образец: What did you order?',true]]},
 verbs:{title:'Три глагола на каждый день',min:10,rule:'Вспомни формы go, see и take. В утвердительном Past Simple нужна V2, после have/has в Present Perfect нужна V3.',note:'V1 — основная форма. V2 — Past Simple. V3 — причастие. Образец: go → went → gone.',task:'Скажи по одному предложению о вчера и об опыте, используя глаголы из занятия.',q:[
 ['Запиши три формы go, see и take по порядку.','go → went → gone · see → saw → seen · take → took → taken',true],
 ['Вставь форму take: I ___ the bus yesterday.','I took the bus yesterday.'],
 ['Вставь форму see: I’ve ___ this film before.','I’ve seen this film before.']]},
 verbs2:{title:'Глаголы для рассказа',min:12,rule:'Вспомни формы write, speak и tell. После did используй V1. В Past Perfect ставь had + V3.',note:'Did she write it? She had written it before I arrived.',task:'Расскажи, кому ты вчера что-то сказала или написала. Затем задай вопрос с did.',q:[
 ['Запиши V1, V2 и V3 для write, speak и tell.','write → wrote → written · speak → spoke → spoken · tell → told → told',true],
 ['Вставь форму speak: We ___ yesterday.','We spoke yesterday.'],
 ['Вставь форму tell: She had ___ me the news before you called.','She had told me the news before you called.']]}
};
const app=document.querySelector('#app'), toast=document.querySelector('#toast');
let state={log:{},saved:{},drafts:{},notes:{}}, route='home', previous='home', timer;
const key='green-notebook-english-v1';
try{const data=JSON.parse(localStorage.getItem(key));if(data) state={...state,...data}}catch{}
function msg(text){toast.textContent=text;clearTimeout(timer);timer=setTimeout(()=>toast.textContent='',3000)}
function persist(){try{localStorage.setItem(key,JSON.stringify(state));return true}catch{msg('Браузер не смог сохранить данные.');return false}}
const esc=(v='')=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const localDay=(d=new Date())=>[d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');
function week(){const today=new Date(), monday=new Date(today.getFullYear(),today.getMonth(),today.getDate()-((today.getDay()+6)%7));return ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'].map((label,i)=>{const day=new Date(monday);day.setDate(day.getDate()+i);return {label,day,count:(state.log[localDay(day)]||[]).length}})}
const count=()=>week().reduce((total,d)=>total+d.count,0);
const done=id=>(state.log[localDay()]||[]).includes(id);
const btn=(target,label,style='secondary')=>'<button class="'+style+'" data-go="'+target+'">'+label+'</button>';
function home(){const next=Object.keys(lessons).find(id=>!Object.values(state.log).some(ids=>ids.includes(id)))||'present';return `
<section class="hero"><div class="hero-copy"><div class="eyebrow">Моя практика английского</div><h1>Зелёная<br>тетрадь</h1><p>10–20 минут на грамматику, живую речь и фразы, которые пригодятся тебе самой.</p>${btn('lesson/'+next,'Начать занятие →','primary')}</div><div class="art" aria-hidden="true"><div class="book"><span>English<br>notes</span></div><div class="pen"></div></div></section>
<div class="section-heading"><h2>Разделы практики</h2></div><div class="grid">${sections.map((s,i)=>`<button class="card tile" data-go="section/${i}"><span class="icon" aria-hidden="true">${s.icon}</span><h3>${s.name}</h3><p>${s.desc}</p><span class="bottom"><span>${s.lessons.length} занятия</span><span aria-hidden="true">→</span></span></button>`).join('')}</div>
<section class="panel overview"><div><div class="eyebrow">На этой неделе</div><h3>Выполнено занятий · ${count()}</h3><p class="muted">На повторении · ${Object.keys(state.saved).length}</p></div>${btn('week','Недельный обзор →')}</section>`}
function section(i){const s=sections[i];return `<section class="page">${btn('home','← На главную','plain')}<h1>${s.name}</h1><p class="muted">${s.desc}</p><div class="stack">${s.lessons.map(id=>`<article class="card row"><div><h3>${lessons[id].title}</h3><p class="muted">${lessons[id].min} мин ${done(id)?' · Выполнено сегодня':''}</p></div>${btn('lesson/'+id,done(id)?'Повторить':'Открыть →')}</article>`).join('')}</div></section>`}
function lesson(id){const l=lessons[id], s=sections.findIndex(x=>x.lessons.includes(id));return `<section class="page lesson">${btn(previous==='review'?'review':'section/'+s,'← К списку','plain')}<div class="eyebrow">${sections[s].name} · ${l.min} мин</div><h1>${l.title}</h1><p>${l.rule}</p><div class="actions"><button class="secondary" data-action="save" data-id="${id}">${state.saved[id]?'✓ Тема сохранена':'Сохранить сложную тему'}</button></div>
<details class="panel"><summary>Запись в зелёную тетрадь</summary><div class="notebook"><strong>${l.title}</strong><br>${l.rule}<br><span lang="en">${l.note}</span><br>Практика. ${l.q[0][0]}</div></details>
<div class="stack">${l.q.map(([prompt,answer,long],i)=>`<fieldset class="panel exercise"><legend>Задание ${i+1}</legend><label>${prompt}${long?`<textarea data-draft="${id}/${i}" aria-label="Черновик задания ${i+1}" placeholder="Твой ответ…">${esc(state.drafts[id+'/'+i])}</textarea>`:`<input data-draft="${id}/${i}" aria-label="Черновик задания ${i+1}" placeholder="Твой ответ…" value="${esc(state.drafts[id+'/'+i])}">`}</label><details class="answer"><summary>Самопроверка</summary><p>${answer}</p><button class="secondary" data-action="error" data-id="${id}" data-index="${i}">${state.saved[id+'/'+i]?'✓ Ошибка сохранена':'Сохранить для повторения'}</button></details></fieldset>`).join('')}</div>
<div class="panel"><strong>Закрепи материал</strong><p>${l.task}</p><button class="primary" data-action="done" data-id="${id}" aria-pressed="${done(id)}">${done(id)?'✓ Выполнено сегодня · отменить':'Отметить выполненным'}</button></div></section>`}
function review(){const items=Object.entries(state.saved);return `<section class="page"><h1>Повторение</h1><p class="muted">Открой сохранённую тему или попробуй снова ответить на вопрос. Когда станет легче, убери запись из списка.</p><div class="stack">${items.length?items.map(([key,entry])=>{const [id,index]=key.split('/'),l=lessons[id];return `<article class="panel"><div class="tag">${index===undefined?'Сложная тема':'Сохранённое упражнение'}</div><h3>${l.title}</h3>${index===undefined?'':`<p>${l.q[index][0]}</p>${entry.answer?`<p class="muted">Твой прошлый ответ · ${esc(entry.answer)}</p>`:''}<details class="answer"><summary>Самопроверка</summary><p>${l.q[index][1]}</p></details>`}<div class="actions">${btn('lesson/'+id,'Открыть занятие')}<button class="plain" data-action="remove" data-id="${key}">Убрать из списка</button></div></article>`}).join(''):'<div class="panel">Сохранённые темы и ошибки появятся здесь.</div>'}</div></section>`}
function progress(){const days=week(), range=days.map(d=>localDay(d.day)), ids=range.flatMap(d=>state.log[d]||[]), date=d=>new Intl.DateTimeFormat('ru-RU',{day:'numeric',month:'short'}).format(d);return `<section class="page lesson"><h1>Недельный обзор</h1><p class="muted">${date(days[0].day)} – ${date(days[6].day)}</p><div class="stack"><section class="panel"><h3>Выполнено занятий · ${ids.length}</h3><p class="muted">Дней с практикой · ${days.filter(d=>d.count).length} из 7</p><div class="week">${days.map(d=>`<div class="day ${d.count?'active':''}">${d.label}<strong>${d.count}</strong></div>`).join('')}</div></section><section class="panel"><h3>Что удалось и что повторить</h3><p>${[...new Set(ids)].map(id=>lessons[id].title).join(' · ')||'На этой неделе пока нет выполненных занятий.'}</p>${btn('review','К повторению · '+Object.keys(state.saved).length)}<div class="exercise"><label for="week-note">Моя запись на неделю</label><textarea id="week-note" data-week="${range[0]}" placeholder="Что стало легче? Что хочу повторить?">${esc(state.notes[range[0]])}</textarea></div></section></div></section>`}
function render(){const [page,id]=route.split('/');app.innerHTML=page==='lesson'?lesson(id):page==='section'?section(id):page==='review'?review():page==='week'?progress():home();document.querySelectorAll('nav button').forEach(b=>b.setAttribute('aria-current',b.dataset.go===(['lesson','section'].includes(page)?'home':page)?'true':'false'))}
function go(){const path=location.hash.slice(1)||'home';const valid=/^(home|review|week|section\/[0-3])$/.test(path)||(path.startsWith('lesson/')&&Object.hasOwn(lessons,path.slice(7)));previous=route;route=valid?path:'home';render();window.scrollTo(0,0)}
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const {go:target,action,id,index}=b.dataset;
